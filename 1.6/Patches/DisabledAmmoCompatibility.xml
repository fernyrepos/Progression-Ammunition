<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Weapon_GrenadeMolotov" and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Weapon_GrenadeMolotov" and not(modExtensions)]</xpath>
      <value><modExtensions /></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Weapon_GrenadeMolotov"]/modExtensions[not(li[@Class="ProgressionAmmunition.AmmoExtension"])]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Weapon_GrenadeMolotov"]/modExtensions[not(li[@Class="ProgressionAmmunition.AmmoExtension"])]</xpath>
      <value><li Class="ProgressionAmmunition.AmmoExtension" /></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Weapon_GrenadeMolotov"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]</xpath>
    <value><disableAmmo>true</disableAmmo></value>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods><li>Vanilla Factions Expanded - Tribals</li></mods>
