<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Each group ensures the extension container exists, adds the extension if needed,
       fills a missing capacity, and normalizes an existing capacity to four. -->
  <Operation Class="PatchOperationFindMod"><mods><li>Vanilla Weapons Expanded</li></mods><match Class="PatchOperationSequence"><operations>
    <li Class="PatchOperationConditional"><xpath>Defs/ThingDef[(defName="VWE_SmokeGrenade" or defName="VWE_Gun_GrenadeLauncher") and not(modExtensions)]</xpath><match Class="PatchOperationAdd"><xpath>Defs/ThingDef[(defName="VWE_SmokeGrenade" or defName="VWE_Gun_GrenadeLauncher") and not(modExtensions)]</xpath><value><modExtensions /></value></match></li>
    <li Class="PatchOperationConditional"><xpath>Defs/ThingDef[defName="VWE_SmokeGrenade" or defName="VWE_Gun_GrenadeLauncher"]/modExtensions[not(li[@Class="ProgressionAmmunition.AmmoExtension"])]</xpath><match Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="VWE_SmokeGrenade" or defName="VWE_Gun_GrenadeLauncher"]/modExtensions[not(li[@Class="ProgressionAmmunition.AmmoExtension"])]</xpath><value><li Class="ProgressionAmmunition.AmmoExtension"><maxAmmo>4</maxAmmo></li></value></match></li>
    <li Class="PatchOperationConditional"><xpath>Defs/ThingDef[defName="VWE_SmokeGrenade" or defName="VWE_Gun_GrenadeLauncher"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension" and not(maxAmmo)]</xpath><match Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="VWE_SmokeGrenade" or defName="VWE_Gun_GrenadeLauncher"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension" and not(maxAmmo)]</xpath><value><maxAmmo>4</maxAmmo></value></match></li>
    <li Class="PatchOperationConditional"><xpath>Defs/ThingDef[defName="VWE_SmokeGrenade" or defName="VWE_Gun_GrenadeLauncher"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/maxAmmo</xpath><match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="VWE_SmokeGrenade" or defName="VWE_Gun_GrenadeLauncher"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/maxAmmo</xpath><value><maxAmmo>4</maxAmmo></value></match></li>
  </operations></match></Operation>

