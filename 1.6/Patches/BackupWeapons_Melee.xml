<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Knife -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="MeleeWeapon_Knife"]/modExtensions</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="MeleeWeapon_Knife"]</xpath>
      <value>
        <modExtensions />
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="MeleeWeapon_Knife"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>Defs/ThingDef[defName="MeleeWeapon_Knife"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/canBeBackupWeapon</xpath>
      <match Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="MeleeWeapon_Knife"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/canBeBackupWeapon</xpath>
        <value>
          <canBeBackupWeapon>true</canBeBackupWeapon>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="MeleeWeapon_Knife"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]</xpath>
        <value>
          <canBeBackupWeapon>true</canBeBackupWeapon>
        </value>
      </nomatch>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="MeleeWeapon_Knife"]/modExtensions</xpath>
      <value>
        <li Class="ProgressionAmmunition.AmmoExtension">
          <canBeBackupWeapon>true</canBeBackupWeapon>
        </li>
      </value>
    </nomatch>
  </Operation>

