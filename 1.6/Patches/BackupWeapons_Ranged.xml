<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Autopistol -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Gun_Autopistol"]/modExtensions</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Gun_Autopistol"]</xpath>
      <value>
        <modExtensions />
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Gun_Autopistol"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>Defs/ThingDef[defName="Gun_Autopistol"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/canBeBackupWeapon</xpath>
      <match Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Gun_Autopistol"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/canBeBackupWeapon</xpath>
        <value>
          <canBeBackupWeapon>true</canBeBackupWeapon>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Gun_Autopistol"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]</xpath>
        <value>
          <canBeBackupWeapon>true</canBeBackupWeapon>
        </value>
      </nomatch>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Gun_Autopistol"]/modExtensions</xpath>
      <value>
        <li Class="ProgressionAmmunition.AmmoExtension">
          <canBeBackupWeapon>true</canBeBackupWeapon>
        </li>
      </value>
    </nomatch>
  </Operation>

