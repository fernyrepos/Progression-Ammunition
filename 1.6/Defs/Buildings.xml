<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Abstract="True" Name="PA_AmmoRechargerBase" ParentName="BuildingBase">
    <thingClass>ProgressionAmmunition.Building_AmmoRecharger</thingClass>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <pathCost>30</pathCost>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <designationCategory>Security</designationCategory>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>30</Mass>
      <WorkToBuild>1000</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <ThingDef ParentName="PA_AmmoRechargerBase">
    <defName>PA_ArrowBox</defName>
    <label>arrow cage</label>
    <description>An infinite supply of arrows, placed in a small cage. Colonists can resupply arrows from this station.</description>
    <graphicData>
      <texPath>Things/Building/ProgressionAmmunition/ArrowCage/ArrowCage</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <shaderType>CutoutComplex</shaderType>
      <shadowData>
        <volume>(0.55, 0.35, 0.3)</volume>
        <offset>(0, 0, -0.28)</offset>
      </shadowData>
    </graphicData>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>300</costStuffCount>
    <researchPrerequisites>
      <li MayRequire="OskarPotocki.VFE.Tribals">VFET_Bow</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="ProgressionAmmunition.AmmoExtension">
        <ammoType>Arrow</ammoType>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="PA_AmmoRechargerBase">
    <defName>PA_AmmoBox</defName>
    <label>ammo crate</label>
    <description>An infinite supply of ammunition, stored in a metal crate. Colonists can resupply ammo and grenades from this box.</description>
    <graphicData>
      <texPath>Things/Building/ProgressionAmmunition/AmmoBox/AmmoBox</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <costList>
      <Steel>300</Steel>
    </costList>
    <researchPrerequisites>
      <li>Gunsmithing</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="ProgressionAmmunition.AmmoExtension">
        <ammoType>Ammo</ammoType>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="PA_AmmoRechargerBase">
    <defName>PA_WeaponCharger</defName>
    <label>weapon charger</label>
    <description>A charging station for high-tech weaponry. Colonists can recharge weapons from this station.</description>
    <graphicData>
      <texPath>Things/Building/ProgressionAmmunition/WeaponCharger/WeaponCharger</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <costList>
      <Steel>500</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>500</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <researchPrerequisites>
      <li>Fabrication</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="ProgressionAmmunition.AmmoExtension">
        <ammoType>Charge</ammoType>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
