<?xml version='1.0' encoding='UTF-8'?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Weapon_GrenadeTox"]/modExtensions</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="Weapon_GrenadeTox"]</xpath>
      <value>
        <modExtensions />
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Weapon_GrenadeTox"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="Weapon_GrenadeTox"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/maxAmmo</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Weapon_GrenadeTox"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/maxAmmo</xpath>
        <value>
          <maxAmmo>4</maxAmmo>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Weapon_GrenadeTox"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]</xpath>
        <value>
          <maxAmmo>4</maxAmmo>
        </value>
      </nomatch>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="Weapon_GrenadeTox"]/modExtensions</xpath>
      <value>
        <li Class="ProgressionAmmunition.AmmoExtension">
          <maxAmmo>4</maxAmmo>
        </li>
      </value>
    </nomatch>
  </Operation>
</Patch>
