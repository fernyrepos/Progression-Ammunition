<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="VWE_Bow_Compound"]/modExtensions</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="VWE_Bow_Compound"]</xpath>
      <value>
        <modExtensions />
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="VWE_Bow_Compound"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="VWE_Bow_Compound"]/modExtensions</xpath>
      <value>
        <li Class="ProgressionAmmunition.AmmoExtension">
          <ammoType>Arrow</ammoType>
        </li>
      </value>
    </nomatch>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="VWE_Bow_Compound"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/ammoType</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="VWE_Bow_Compound"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/ammoType</xpath>
        <value>
          <ammoType>Arrow</ammoType>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="VWE_Bow_Compound"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]</xpath>
        <value>
          <ammoType>Arrow</ammoType>
        </value>
      </nomatch>
    </match>
  </Operation>
</Patch>