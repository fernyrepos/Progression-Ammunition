<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="VWE_Throwing_Rocks"]/modExtensions</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="VWE_Throwing_Rocks"]</xpath>
      <value>
        <modExtensions />
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="VWE_Throwing_Rocks"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="VWE_Throwing_Rocks"]/modExtensions</xpath>
      <value>
        <li Class="ProgressionAmmunition.AmmoExtension">
          <disableAmmo>true</disableAmmo>
        </li>
      </value>
    </nomatch>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="VWE_Throwing_Rocks"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/disableAmmo</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="VWE_Throwing_Rocks"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/disableAmmo</xpath>
        <value>
          <disableAmmo>true</disableAmmo>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="VWE_Throwing_Rocks"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]</xpath>
        <value>
          <disableAmmo>true</disableAmmo>
        </value>
      </nomatch>
    </match>
  </Operation>
</Patch>