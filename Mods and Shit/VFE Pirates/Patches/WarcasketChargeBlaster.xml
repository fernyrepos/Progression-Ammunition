<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_ChargeBlaster"]/modExtensions</xpath>
