        <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_ChargeBlaster"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/ammoType</xpath>
        <value>
          <ammoType>Charge</ammoType>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_ChargeBlaster"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]</xpath>
        <value>
          <ammoType>Charge</ammoType>
        </value>
      </nomatch>
    </match>
  </Operation>
