<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!-- Autocannon -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="VWE_Gun_Autocannon"]/modExtensions</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="VWE_Gun_Autocannon"]</xpath>
      <value>
        <modExtensions />
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="VWE_Gun_Autocannon"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="VWE_Gun_Autocannon"]/modExtensions</xpath>
      <value>
        <li Class="ProgressionAmmunition.AmmoExtension">
          <disableAmmo>true</disableAmmo>
        </li>
      </value>
    </nomatch>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="VWE_Gun_Autocannon"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/disableAmmo</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="VWE_Gun_Autocannon"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]/disableAmmo</xpath>
        <value>
          <disableAmmo>true</disableAmmo>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="VWE_Gun_Autocannon"]/modExtensions/li[@Class="ProgressionAmmunition.AmmoExtension"]</xpath>
        <value>
          <disableAmmo>true</disableAmmo>
        </value>
      </nomatch>
    </match>
  </Operation>
  
