<?xml version="1.0" encoding="UTF-8"?>
<Patch>
  <!-- Grenadier Armor -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Apparel_ArmorMarineGrenadier"]/comps/li[@Class="CompProperties_ApparelReloadable"]/ammoDef</xpath>
    <value>
      <ammoDef>PA_AmmoRefill</ammoDef>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="Apparel_ArmorMarineGrenadier"]/comps/li[@Class="CompProperties_ApparelReloadable"]/ammoCountPerCharge</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Apparel_ArmorMarineGrenadier"]/comps/li[@Class="CompProperties_ApparelReloadable"]</xpath>
    <value>
      <ammoCountToRefill>1</ammoCountToRefill>
    </value>
  </Operation>
</Patch>